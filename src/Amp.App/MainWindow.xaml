<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Amp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Amp.App.Controls"
    xmlns:models="using:Amp.App.Models"
    xmlns:sdk="using:Amp.Sdk"
    Title="Amp">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Transcript row templates -->
            <DataTemplate x:Key="UserTurnTemplate" x:DataType="models:UserTurnItem">
                <Border
                    MaxWidth="720"
                    Margin="48,8,0,8"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12,12,2,12">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AssistantTextTemplate" x:DataType="models:AssistantTextItem">
                <controls:MarkdownView Margin="0,6,48,6" Markdown="{x:Bind Markdown, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="ThinkingTemplate" x:DataType="models:ThinkingItem">
                <Expander
                    Margin="0,4,48,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Thinking" />
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="ToolCallTemplate" x:DataType="models:ToolCallItem">
                <Expander
                    Margin="0,4,48,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CodeFontFamily}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Summary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Input, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Border
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind HasResult, Mode=OneWay}">
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto">
                                <TextBlock
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Result, Mode=OneWay}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="StatusTemplate" x:DataType="models:StatusItem">
                <InfoBar
                    Margin="0,4,48,4"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind Text}"
                    Severity="{x:Bind controls:Formatting.Severity(IsError)}" />
            </DataTemplate>

            <controls:TranscriptTemplateSelector
                x:Key="TranscriptTemplates"
                AssistantText="{StaticResource AssistantTextTemplate}"
                Status="{StaticResource StatusTemplate}"
                Thinking="{StaticResource ThinkingTemplate}"
                ToolCall="{StaticResource ToolCallTemplate}"
                UserTurn="{StaticResource UserTurnTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Amp">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: thread list -->
            <Grid
                Padding="12,0,0,12"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,8,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.NewThreadCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New thread" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.RefreshThreadsCommand}"
                        ToolTipService.ToolTip="Refresh threads">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Threads}"
                    SelectedItem="{x:Bind ViewModel.SelectedThread, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sdk:ThreadSummary">
                            <StackPanel Margin="0,6" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind controls:Formatting.TitleOrId(Title, Id)}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind controls:Formatting.Relative(Updated)}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressBar
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoadingThreads, Mode=OneWay}" />
                <InfoBar
                    Grid.Row="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Bottom"
                    IsOpen="{x:Bind controls:Formatting.IsNotEmpty(ViewModel.ThreadListError), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ThreadListError, Mode=OneWay}"
                    Severity="Error" />

                <Button
                    Grid.Row="2"
                    Margin="0,8,12,0"
                    HorizontalAlignment="Stretch"
                    Click="Settings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Conversation -->
            <Grid Grid.Column="1" Padding="24,0,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,8,0,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Conversation.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton
                            Padding="0"
                            Click="OpenThread_Click"
                            Content="{x:Bind ViewModel.Conversation.ThreadUrl, Mode=OneWay}"
                            FontSize="12"
                            Visibility="{x:Bind ViewModel.Conversation.HasThread, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ComboBox
                            x:Name="ExecutorBox"
                            MinWidth="110"
                            Header="Executor"
                            ItemsSource="{x:Bind Executors}"
                            SelectedItem="{x:Bind ViewModel.Conversation.Executor, Mode=OneWay}"
                            SelectionChanged="Picker_SelectionChanged" />
                        <ComboBox
                            x:Name="ModeBox"
                            MinWidth="110"
                            Header="Mode"
                            ItemsSource="{x:Bind Modes}"
                            SelectedItem="{x:Bind ViewModel.Conversation.Mode, Mode=OneWay}"
                            SelectionChanged="Picker_SelectionChanged" />
                        <ComboBox
                            x:Name="EffortBox"
                            MinWidth="110"
                            Header="Effort"
                            ItemsSource="{x:Bind Efforts}"
                            SelectedItem="{x:Bind ViewModel.Conversation.Effort, Mode=OneWay}"
                            SelectionChanged="Picker_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1">
                    <ItemsRepeater
                        Margin="0,0,12,0"
                        ItemTemplate="{StaticResource TranscriptTemplates}"
                        ItemsSource="{x:Bind ViewModel.Conversation.Items, Mode=OneWay}" />
                </ScrollViewer>
                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind ViewModel.Conversation.IsLoadingHistory, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Conversation.IsLoadingHistory, Mode=OneWay}" />
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind controls:Formatting.IsEmpty(ViewModel.Conversation.Items.Count), Mode=OneWay}">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8BD;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ask Amp anything. Enter sends, Shift+Enter adds a line." />
                </StackPanel>

                <!-- Composer -->
                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Folder" />
                        <TextBox
                            Grid.Column="1"
                            FontSize="12"
                            PlaceholderText="Working directory for local runs (defaults to the app's folder)"
                            Text="{x:Bind ViewModel.Conversation.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Click="PickFolder_Click"
                            ToolTipService.ToolTip="Choose folder">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="Composer"
                            MinHeight="44"
                            MaxHeight="220"
                            AcceptsReturn="True"
                            IsEnabled="{x:Bind controls:Formatting.Not(ViewModel.Conversation.IsRunning), Mode=OneWay}"
                            PlaceholderText="Message Amp…"
                            PreviewKeyDown="Composer_PreviewKeyDown"
                            Text="{x:Bind ViewModel.Conversation.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Height="44"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.Conversation.SendCommand, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Send (Enter)"
                            Visibility="{x:Bind controls:Formatting.Not(ViewModel.Conversation.IsRunning), Mode=OneWay}">
                            <FontIcon FontSize="16" Glyph="&#xE724;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Height="44"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.Conversation.CancelCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Stop"
                            Visibility="{x:Bind ViewModel.Conversation.IsRunning, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="True" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- First-run / setup overlay -->
        <Grid Grid.Row="1" Visibility="{x:Bind controls:Formatting.Not(ViewModel.IsReady), Mode=OneWay}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Welcome to Amp" />

                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsCheckingCli, Mode=OneWay}">
                    <ProgressRing IsActive="True" />
                    <TextBlock VerticalAlignment="Center" Text="Checking for the Amp CLI…" />
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.NeedsInstall, Mode=OneWay}">
                    <TextBlock Text="The Amp CLI was not found. Install it, then come back here." TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="{StaticResource CodeFontFamily}"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        Text="irm https://ampcode.com/install.ps1 | iex" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.InstallCommand}" Content="Install Amp CLI" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.RefreshStatusCommand}" Content="Check again" />
                        <Button Click="Settings_Click" Content="Set path manually…" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.NeedsSignIn, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="Sign in with your browser, or paste an API key in Settings." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.SignInCommand}" Content="Sign in" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.RefreshStatusCommand}" Content="Check again" />
                        <Button Click="Settings_Click" Content="Settings…" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
